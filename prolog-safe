#!/bin/bash
# Multi-engine safety wrapper script for Prolog interpreters.
# Enforces memory limits (MemoryMax=50M), CPU quota (CPUQuota=65%), priority (nice),
# and wall-clock execution limits (timeout 20s) to prevent system freezes.

# Configurable environment variables
ENGINE="${PROLOG_ENGINE:-scryer}"
TIMEOUT="${PROLOG_TIMEOUT:-20s}"
MEMORY_MAX="${PROLOG_MEMORY_MAX:-50M}"
CPU_QUOTA="${PROLOG_CPU_QUOTA:-65%}"

# Resolve binary based on PROLOG_ENGINE
case "$ENGINE" in
    scryer|scryer-prolog)
        ENGINE_BIN="scryer-prolog"
        ;;
    swi|swipl)
        ENGINE_BIN="swipl"
        ;;
    trealla|tpl)
        ENGINE_BIN="tpl"
        ;;
    gnu|gprolog)
        ENGINE_BIN="gprolog"
        ;;
    ciao)
        ENGINE_BIN="ciao"
        ;;
    *)
        ENGINE_BIN="$ENGINE"
        ;;
esac

if ! command -v "$ENGINE_BIN" >/dev/null 2>&1; then
    echo "[prolog-safe] ERROR: Prolog engine binary '$ENGINE_BIN' not found on PATH." >&2
    exit 127
fi

# Run under systemd-run cgroups if available
if command -v systemd-run >/dev/null 2>&1 && [ -d /sys/fs/cgroup ]; then
    exec systemd-run --user --pty \
      --property=MemoryMax="$MEMORY_MAX" \
      --property=CPUQuota="$CPU_QUOTA" \
      --working-directory="$PWD" \
      timeout --foreground "$TIMEOUT" nice -n 19 "$ENGINE_BIN" "$@"
fi

# Fallback: Run with timeout and nice
if command -v timeout >/dev/null 2>&1; then
    exec timeout --foreground "$TIMEOUT" nice -n 19 "$ENGINE_BIN" "$@"
fi

# Final fallback: Run nice
exec nice -n 19 "$ENGINE_BIN" "$@"
