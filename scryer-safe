#!/bin/bash
# Local Scryer Prolog safety wrapper delegating to prolog-safe
export PROLOG_ENGINE="scryer"
THIS_DIR=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")

if [ -x "$THIS_DIR/prolog-safe" ]; then
    exec "$THIS_DIR/prolog-safe" "$@"
elif command -v prolog-safe >/dev/null 2>&1; then
    exec prolog-safe "$@"
else
    exec systemd-run --user --pty --property=MemoryMax=50M --property=CPUQuota=65% --working-directory="$PWD" timeout --foreground 20s nice -n 19 scryer-prolog "$@"
fi
