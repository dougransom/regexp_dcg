#!/bin/sh
# Wrapper to run Scryer Prolog safely under resource limits (cgroups / systemd-run / ulimit / nice)

# 1. Respect SCRYER_PROLOG environment variable if explicitly set
if [ -n "$SCRYER_PROLOG" ]; then
    exec "$SCRYER_PROLOG" "$@"
fi

# 2. Fallback: Use systemd-run if available for cgroup memory & CPU limits
if command -v systemd-run >/dev/null 2>&1; then
    exec systemd-run --user --quiet --pipe \
      --property=MemoryMax=50M \
      --property=CPUQuota=65% \
      --working-directory="$PWD" \
      scryer-prolog "$@"
fi

# 3. Fallback: Use timeout and nice if systemd-run is not active
if command -v timeout >/dev/null 2>&1; then
    exec timeout 30s nice -n 10 scryer-prolog "$@"
fi

# 4. Final fallback: Run directly
exec scryer-prolog "$@"
